[Unit]
Description=Receipt Bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/receipt-bot
ExecStart=/home/ubuntu/receipt-bot/.venv/bin/python -m receipt_bot
Restart=on-failure
RestartSec=5

# Мінімум прав: код і секрети лише читаються, писати можна тільки в data/.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/receipt-bot/data
PrivateTmp=true
# Якщо колись знайдеться діра в розборі картинок — щоб з процесу бота не вийти далі.
UMask=0077
MemoryMax=1200M
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
