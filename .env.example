# Telegram
BOT_TOKEN=

# Google: шлях до JSON-ключа service account (файл поза репо)
GOOGLE_SA_KEY_FILE=/home/ubuntu/secrets/service-account.json
# OAuth client типу "TVs and Limited Input devices" (device flow), JSON з консолі
GOOGLE_OAUTH_CLIENT_FILE=/home/ubuntu/secrets/oauth-client.json
SHEET_ID=

# Фото в Drive вантажаться від імені власника папки (drive.file): service account
# на звичайному Gmail не має квоти Drive. Токен створює одноразова авторизація власника.
GOOGLE_OWNER_TOKEN_FILE=/home/ubuntu/secrets/owner-token.json
DRIVE_FOLDER_ID=

# Vision-модель: будь-який OpenAI-сумісний API. Основний + запасний (бере фото, коли основний
# вичерпав денний ліміт, впав або відповів сміттям). Замір 25.09 на 24 справжніх документах:
# Cloudflare Gemma — 22/24, ~1100 чеків/добу безкоштовно; Groq Qwen — ~80 чеків/добу.

# Основний — Cloudflare Workers AI. Токен: Workers AI -> Use REST API -> Create a Workers AI API Token;
# Account ID — на тій самій сторінці. Ліміт: 10K нейронів/добу (скидається о 00:00 UTC), далі — помилка, не рахунок.
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
LLM_API_KEY=
LLM_REASONING_EFFORT=
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Запасний — Groq (порожній LLM_FALLBACK_BASE_URL — вимкнено). Ключ: console.groq.com -> API Keys.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_REASONING_EFFORT=none
LLM_FALLBACK_EXTRA_BODY=

# стеля розпізнавань на добу на всю команду (запобіжник; лише з Groq — ~80, це його безкоштовна стеля)
DAILY_RECOGNITIONS=300

DB_PATH=data/bot.db

# Тимчасово, до Google-авторизації: Telegram ID через кому, кому можна надсилати чеки
DEV_ALLOWED_USER_IDS=
