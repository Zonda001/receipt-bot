# Telegram
BOT_TOKEN=

# Google: шлях до JSON-ключа service account (файл поза репо)
GOOGLE_SA_KEY_FILE=/home/ubuntu/secrets/service-account.json
# OAuth client типу "TVs and Limited Input devices" (device flow), JSON з консолі
GOOGLE_OAUTH_CLIENT_FILE=/home/ubuntu/secrets/oauth-client.json
SHEET_ID=

# Фото в Drive вантажаться від імені власника папки (drive.file): service account
# на звичайному Gmail не має квоти Drive. Токен створює одноразова авторизація власника.
GOOGLE_OWNER_TOKEN_FILE=/home/ubuntu/secrets/owner-token.json
DRIVE_FOLDER_ID=

# Vision-модель: будь-який OpenAI-сумісний API
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

DB_PATH=data/bot.db
